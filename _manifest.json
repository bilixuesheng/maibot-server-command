{
  "manifest_version": 2,
  "id": "xuesheng.maibot-server-command",
  "version": "1.0.14",
  "name": "服务器命令执行",
  "description": "让 MaiBot 安全运行服务器命令、发送非敏感文件并自动清理受管临时文件",
  "author": {
    "name": "XUESHENG",
    "url": "https://github.com/bilixuesheng"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/bilixuesheng/maibot-server-command"
  },
  "host_application": {
    "min_version": "1.0.8",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "terminal",
      "background": "#F3F4F6"
    }
  },
  "capabilities": [
    "send.custom",
    "chat.get_all_streams",
    "chat.get_group_streams",
    "chat.get_private_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
