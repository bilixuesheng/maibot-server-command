{
  "manifest_version": 2,
  "id": "xuesheng.maibot-server-command",
  "version": "1.0.10",
  "name": "服务器命令执行",
  "description": "让 MaiBot 在低权限沙箱中运行 Ubuntu 命令，并提供可选 ROOT 最高权限模式",
  "author": {
    "name": "XUESHENG",
    "url": "https://github.com/bilixuesheng"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/bilixuesheng/maibot-server-command"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "terminal",
      "background": "#F3F4F6"
    }
  },
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
